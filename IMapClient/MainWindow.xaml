<Window x:Class="IMapClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMapClient"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="187"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Vertical" Grid.RowSpan="8">
            <TextBox IsReadOnly="True" TextAlignment="Center" Padding="7" FontWeight="Bold">Folders</TextBox>
            <ListBox Margin="4" Name="listBox"></ListBox>
        </StackPanel>

        <Button Grid.Column="1" Margin="15" Click="Button_Click" VerticalAlignment="Top">Click</Button>
        <Button Grid.Column="4" Margin="15" Click="CloseBtn_Click" VerticalAlignment="Top">Close</Button>
    </Grid>
</Window>
